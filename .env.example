# DiSản Lens — backend/core configuration
# Copy this file to .env, then replace placeholders locally. Never commit .env.

# Canonical dataset paths, relative to the repository root.
IMAGE_ROOT=images
JSON_ROOT=JSON

# OpenCLIP image encoder. Leave CLIP_DEVICE empty for automatic CUDA/CPU choice.
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
# CLIP_DEVICE=cuda

# Existing Pinecone index. The web API only queries it; it does not create or re-index it.
PINECONE_API_KEY=replace-with-your-pinecone-api-key
PINECONE_INDEX_NAME=di-san-lens
PINECONE_NAMESPACE=heritage-images-v1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_TIMEOUT_SECONDS=30

# Optional Supabase backend repository. Leave both empty to use the JSON fallback.
# The service-role key is backend-only and must never use a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anonymous local analytics used by the JSON fallback. Uploaded image bytes are not stored.
ANALYTICS_SQLITE_PATH=data/analytics.sqlite3

# FastAPI runtime and allowed browser origins (comma-separated, no wildcard in production).
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RECOGNITION_RATE_LIMIT_PER_MINUTE=30
REQUEST_CONTEXT_TTL_SECONDS=3600
REQUEST_CONTEXT_MAX_ENTRIES=10000
FEEDBACK_RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_MAX_CLIENTS=10000

# Upload safety limits.
MAX_UPLOAD_MB=12
MAX_IMAGE_PIXELS=25000000
MAX_CONCURRENT_RECOGNITIONS=2
MULTIPART_OVERHEAD_BYTES=65536
MAX_JSON_BODY_BYTES=8192
REQUEST_BODY_TIMEOUT_SECONDS=30

# Explainable image-quality heuristics. Calibrate with real phone photos before launch.
QUALITY_MIN_WIDTH=320
QUALITY_MIN_HEIGHT=320
QUALITY_DARK_MEAN_MAX=45
QUALITY_DARK_P75_MAX=70
QUALITY_BRIGHT_MEAN_MIN=225
QUALITY_BRIGHT_P25_MIN=210
QUALITY_BLUR_LAPLACIAN_MIN=80
QUALITY_GLARE_LUMINANCE_MIN=245
QUALITY_GLARE_CHROMA_MAX=18
QUALITY_GLARE_RATIO_MAX=0.18

# Cosine-similarity confidence gate. Scores are similarity values, not accuracy percentages.
CONFIDENCE_ACCEPT=0.72
CONFIDENCE_CANDIDATE=0.55
CONFIDENCE_MARGIN=0.08
CANDIDATE_COUNT=3
PINECONE_QUERY_OVERFETCH=50
